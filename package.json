{
  "name": "computational-physics-workbench",
  "private": true,
  "version": "0.1.1",
  "description": "An agent-operated, human-reviewed research workbench for computational and theoretical physics.",
  "author": "Shuai Yan",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ysdsga/Computational-Physics-Workbench.git"
  },
  "bugs": {
    "url": "https://github.com/ysdsga/Computational-Physics-Workbench/issues"
  },
  "homepage": "https://github.com/ysdsga/Computational-Physics-Workbench#readme",
  "keywords": [
    "computational-physics",
    "theoretical-physics",
    "research-workflow",
    "human-in-the-loop",
    "scientific-agents",
    "dft",
    "dmft"
  ],
  "type": "module",
  "bin": {
    "workbench": "bin/workbench.js"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx server/index.ts",
    "dev:full": "concurrently \"npm:dev:server\" \"npm:dev\"",
    "typecheck": "tsc -b && tsc -p server/tsconfig.json --noEmit",
    "build": "npm run typecheck && vite build",
    "start": "tsx server/index.ts",
    "lint": "oxlint",
    "test": "node --test --import tsx \"tests/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:remote:prepare": "node tests/live-remote.mjs prepare",
    "test:remote:execute": "node tests/live-remote.mjs execute",
    "preview": "vite preview"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
